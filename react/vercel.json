{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://gestionstage-frontend-backend.onrender.com/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://gestionstage-frontend-backend.onrender.com/api"
  }
}