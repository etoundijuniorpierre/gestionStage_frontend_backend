{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": true,
    "productionBranch": "prod"
  },
  "env": {
    "REACT_APP_API_URL": "https://gestionstage-frontend-backend.onrender.com"
  },
  "build": {
    "env": {
      "REACT_APP_API_URL": "https://gestionstage-frontend-backend.onrender.com"
    }
  }
}