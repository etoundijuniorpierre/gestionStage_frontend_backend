{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "installCommand": "npm install",
        "buildCommand": "npm run build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": true,
    "productionBranch": "prod"
  },
  "env": {
    "VITE_API_URL": "https://gestionstage-frontend-backend.onrender.com/api"
  },
  "build": {
    "env": {
      "VITE_API_URL": "https://gestionstage-frontend-backend.onrender.com/api"
    }
  }
}